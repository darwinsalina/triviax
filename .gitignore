# ── graphify ──────────────────────────────────────────────
# Grafo de conocimiento generado (se reconstruye con `graphify update .`)
graphify-out/

# ── TRIVIAX: datos de runtime y trabajo temporal ──────────
# Borradores y artefactos de prueba (ver memoria del proyecto)
scratch/

# Reportes y estadísticas generados por el modo filesystem
proyectos/*/reportes/
proyectos/*/stats.json

# ── Secretos / credenciales ───────────────────────────────
# La conexión real vive fuera del repo (C:/wamp64/dbconn/), pero por las dudas:
**/dbkey_*.php
*.env
.env

# ── Material que NO se sube ────────────────────────────────
# "NoSubir" lo dice su nombre; trash/ son descartes
NoSubir/
trash/

# Laboratorio local de experimentos (splash, jigsaw, etiquetados): NO se sube.
# Las versiones definitivas viven fuera de experimental/ (modalidades reales).
experimental/

# ── Actividades con imágenes (v6.0): imágenes subidas en runtime ──────────
# Se conserva la estructura de carpetas (.gitkeep) pero no las imágenes.
media/jigsaw/*
media/etiquetar/*
!media/jigsaw/.gitkeep
!media/etiquetar/.gitkeep

# ── Colecciones de fichas (v7.x): sprite sheets y fichas generadas en runtime ──
# El código crea uploads/token_sets/<docente>/<set>/ con mkdir recursivo,
# así que no hace falta versionar la carpeta; solo se ignora su contenido.
uploads/

# ── Herramientas de agentes / skills instaladas ───────────
.codex/
.agents/
.claude/
skills-lock.json

# ── Sistema operativo / editores ──────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────
*.log
