# ─────────────────────────────────────────────────────────────────────────
# TRIVIAX — Plantilla de variables de entorno
#
# Copia este archivo a la carpeta dbconn/ FUERA de la raíz pública, como:
#   <wamp>/dbconn/triviax.env          (p. ej. C:\wamp64\dbconn\triviax.env)
# y completa los valores. NUNCA lo dejes dentro de la carpeta servida ni lo
# subas al repositorio con secretos reales.
#
# Formato: CLAVE=valor (una por línea). Las líneas que empiezan con # son
# comentarios. Los valores booleanos aceptan true/false/1/0.
#
# Las CREDENCIALES DE BASE DE DATOS NO van aquí: viven en
#   dbconn/dbkey_triviax.php  (ver php/db.php).
# ─────────────────────────────────────────────────────────────────────────

# ── Entorno ───────────────────────────────────────────────────────────────
# APP_ENV: production | local. En producción usa "production".
APP_ENV=production

# APP_DEBUG: muestra errores PHP en pantalla. DEBE ser false en producción
# (de lo contrario se filtran rutas, trazas y posibles credenciales).
APP_DEBUG=false

# MAINTENANCE_MODE: si es true, la API responde 503 a todos salvo superadmin.
MAINTENANCE_MODE=false

# ── Seguridad / sesión ──────────────────────────────────────────────────────
# APP_SECRET: clave larga y aleatoria usada para cifrado y derivaciones.
# Genera una con, p. ej.: php -r "echo bin2hex(random_bytes(32));"
# REQUERIDA en producción.
APP_SECRET=

# Nombre de la cookie de sesión (opcional).
SESSION_NAME=TRIVIAXSESID

# RATE_LIMIT_ENABLED: limita por IP el login, registro, unirse_sesion, etc.
# Mantener en true en producción.
RATE_LIMIT_ENABLED=true

# ── Correo ──────────────────────────────────────────────────────────────────
# ADMIN_EMAIL: destinatario de las notificaciones internas (p. ej. "nueva
# actividad creada"). Si se omite, se usa el valor por defecto del código.
ADMIN_EMAIL=admin@tu-dominio.edu

# MAIL_FROM: dirección remitente de los correos salientes.
MAIL_FROM=triviax@tu-dominio.edu

# ── Registro docente ─────────────────────────────────────────────────────────
# TEACHER_INVITE_CODE: si se define, el registro docente exige este código.
# Vacío = registro abierto (con anti-bot Turnstile, ver abajo).
TEACHER_INVITE_CODE=

# ── Cloudflare Turnstile (anti-bot del registro abierto) ──────────────────────
# Obtén las claves en https://dash.cloudflare.com/ -> Turnstile.
# El anti-bot se ACTIVA automáticamente cuando ambas claves están presentes.
# En entornos locales queda desactivado salvo TURNSTILE_FORCE_LOCAL=true.
# >>> Completar AMBAS en producción para cerrar el registro abierto. <<<
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FORCE_LOCAL=false

# ── IA (generación de actividades Lotto, opcional) ────────────────────────────
# Si se definen, el panel puede generar actividades directamente con el LLM;
# si no, el flujo manual (prompt + pegar JSON) sigue disponible.
LLM_PROVIDER=
LLM_API_KEY=
