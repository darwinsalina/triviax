# triviax/.htaccess — Reglas de seguridad y acceso
# ──────────────────────────────────────────────────────────────

# ── 1. Bloquear extensiones sensibles ─────────────────────────
# Nadie debe poder descargar dumps SQL, backups, logs ni .env
# desde el webroot.
<FilesMatch "\.(sql|bak|zip|tar|gz|log|env|sh|ps1|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── 2. Excepción: manifiest.json y README.md son archivos públicos legítimos ──
<FilesMatch "^(manifest\.json)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

# ── 3. Bloquear acceso a carpetas internas ─────────────────────
# scratch/ contiene scripts de diagnóstico; docs/ tiene PDFs
# que no deben exponerse sin autenticación.
# (Dejar habilitado solo si el servidor lo respeta;
#  los subdirectorios con su propio .htaccess tienen prioridad.)

# ── 4. Evitar listado de directorios ──────────────────────────
Options -Indexes

# ── 5. Cabeceras de seguridad (si mod_headers está activo) ────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
